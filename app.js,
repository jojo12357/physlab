let activeQuestion=null,answered=false;function newQuestion(){const ch=$('#quiz-chapter')?.value||'all',lv=$('#quiz-level')?.value||'all';let pool=quizzes.filter(q=>(ch==='all'||q[0]===ch)&&(lv==='all'||String(q[1])===lv));if(!pool.length)pool=quizzes;activeQuestion=pool[Math.floor(Math.random()*pool.length)];answered=false;const q=activeQuestion;$('#quiz-card').innerHTML=`<div class="quiz-question"><span class="qmeta">${q[0]} · ${['','Бастапқы','Орташа','Күрделі'][q[1]]} деңгей</span><h2>${q[2]}</h2><div class="answers">${q[3].map((a,i)=>`<button class="answer" data-answer="${i}">${String.fromCharCode(65+i)}. ${a}</button>`).join('')}</div><div id="feedback"></div></div>`;$$('[data-answer]').forEach(b=>b.onclick=()=>checkAnswer(+b.dataset.answer))}function checkAnswer(i){if(answered)return;answered=true;const q=activeQuestion;$$('[data-answer]').forEach(b=>{b.disabled=true;if(+b.dataset.answer===q[4])b.classList.add('correct');if(+b.dataset.answer===i&&i!==q[4])b.classList.add('wrong')});$('#feedback').innerHTML=`<div class="feedback ${i===q[4]?'good':'bad'}"><b>${i===q[4]?'Дұрыс!':'Қате жауап.'}</b> ${q[5]}</div>`}$('#new-question').onclick=newQuestion;$('#quiz-chapter').innerHTML='<option value="all">Барлық тарау</option>'+[...new Set(quizzes.map(q=>q[0]))].map(c=>`<option>${c}</option>`).join('');
